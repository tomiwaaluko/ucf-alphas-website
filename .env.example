# ==============================================================================
# RESEND API CONFIGURATION - Contact Form Email Service
# ==============================================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to create your own .env file:
#    - Windows: copy .env.example .env
#    - Mac/Linux: cp .env.example .env
# 
# 2. Get your Resend API key:
#    - Sign up at https://resend.com
#    - Go to https://resend.com/api-keys
#    - Click "Create API Key"
#    - Copy the key (starts with "re_")
# 
# 3. Configure FROM_EMAIL (sender address):
#    OPTION A - Quick Testing (No setup required):
#      Use: onboarding@resend.dev
#      ✅ Works immediately
#      ❌ May go to spam
#      ❌ Not for production
# 
#    OPTION B - Production (Recommended):
#      Verify your domain in Resend first:
#      - Go to https://resend.com/domains
#      - Add your domain (e.g., ucfalphas.org)
#      - Add DNS records (MX, TXT, DKIM)
#      - Wait 5-30 minutes for verification
#      - Use: noreply@yourdomain.com
# 
# 4. Set TO_EMAIL to where you want to receive contact form submissions
# 
# ==============================================================================

# REQUIRED: Your Resend API key
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# REQUIRED: Where to send contact form emails
# Example: info@ucfalphas.org, president@ucfalphas.org
TO_EMAIL=your-email@example.com

# REQUIRED: Who the email appears to be from (must be verified in Resend)
# For testing: onboarding@resend.dev
# For production: noreply@yourdomain.com (after domain verification)
FROM_EMAIL=onboarding@resend.dev

# ==============================================================================
# DEPLOYMENT NOTES:
# ==============================================================================
# 
# FOR VERCEL DEPLOYMENT:
# - Set these same variables in Vercel Dashboard:
#   1. Go to: https://vercel.com/dashboard
#   2. Select your project → Settings → Environment Variables
#   3. Add all three variables above
#   4. Select Production, Preview, and Development environments
#   5. Redeploy your site
# 
# SECURITY:
# - Never commit your .env file to Git (it's already in .gitignore)
# - Never expose RESEND_API_KEY in client-side code
# - Keep API keys secret and rotate them if compromised
# 
# ==============================================================================

# LEGACY VARIABLES (NO LONGER USED - Keep commented out)
# These were used in older versions but are now handled server-side for security
# VITE_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_FROM_EMAIL=email@ucfalphas.org
# VITE_TO_EMAIL=email@ucfalphas.org
